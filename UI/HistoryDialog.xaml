<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="History.Title"
        Height="560" Width="980" MinHeight="400" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="24,16">
            <StackPanel>
                <TextBlock Uid="History.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Name="TxtHistUser" Text="" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,0">
            <DataGrid Name="DgHist">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="History.Col.Date" Binding="{Binding DateText}" SortMemberPath="Date" Width="140"/>
                    <DataGridTextColumn Header="History.Col.Activity" Binding="{Binding Activity}" Width="260" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="History.Col.Result" Binding="{Binding Result}" Width="90"/>
                    <DataGridTextColumn Header="History.Col.InitiatedBy" Binding="{Binding InitiatedBy}" Width="220" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="History.Col.Details" Binding="{Binding Details}" Width="*" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Name="TxtHistEmpty" Text="" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedText}" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="600"/>
        </Grid>

        <Grid Grid.Row="2" Margin="20,10,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Uid="History.Info" Style="{StaticResource Label}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Name="BtnHistClose" Uid="Common.Close" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
