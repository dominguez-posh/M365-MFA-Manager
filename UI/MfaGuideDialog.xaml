<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="Guide.Title"
        Width="860" Height="900" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBackground}" Padding="24,16">
            <StackPanel>
                <TextBlock Uid="Guide.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Uid="Guide.Subtitle" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <TextBlock Uid="Guide.To" Style="{StaticResource FormLabel}"/>
                <TextBlock Grid.Column="1" Name="TxtGuideTo" Text="-" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Uid="Guide.From" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtGuideFrom" Uid="Guide.FromBox" Padding="8,6" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Uid="Guide.Language" Style="{StaticResource FormLabel}"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox Name="CmbGuideLanguage" Uid="Guide.LanguageBox" Width="180" Padding="8,5" VerticalAlignment="Center" DisplayMemberPath="Name"/>
                    <TextBlock Name="TxtGuideLanguageHint" Text="" FontSize="12" Foreground="{StaticResource MutedText}" Margin="12,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Uid="Guide.Subject" Style="{StaticResource FormLabel}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtGuideSubject" Text="-" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="24,14,24,0" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="White">
            <WebBrowser Name="WebGuidePreview"/>
        </Border>

        <Grid Grid.Row="3" Margin="24,12,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="TxtGuideInfo" Uid="Guide.AttributeHint" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnGuideCancel" Uid="Common.Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                <Button Name="BtnGuideSend" Uid="Guide.Send" Tag="&#xE715;" IsDefault="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
