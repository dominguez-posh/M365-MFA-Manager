<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="BreakGlass.Title"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel>
            <Border Background="{StaticResource HeaderBackground}" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Uid="BreakGlass.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Uid="BreakGlass.Subtitle" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Name="BtnHelp" Uid="Header.Help" Tag="&#xE897;" Style="{StaticResource HeaderButton}"/>
                </Grid>
            </Border>

            <StackPanel Margin="24,10,24,20">
                <TextBlock Uid="BreakGlass.Domain" Style="{StaticResource FormLabel}"/>
                <ComboBox Name="CmbBgDomain" Uid="BreakGlass.DomainBox" Padding="8"/>
                <TextBlock Name="TxtBgUpnHint" Text="" Style="{StaticResource FormLabel}" Margin="0,4,0,0"/>

                <CheckBox Name="ChkBgGlobalAdmin" Uid="BreakGlass.AssignGlobalAdmin" IsChecked="True" Margin="0,16,0,0"/>

                <CheckBox Name="ChkBgFido2" Uid="BreakGlass.RegisterFido2" IsChecked="True" Margin="0,10,0,0"/>
                <StackPanel Name="PnlBgSerial" Margin="22,0,0,0">
                    <TextBlock Uid="Config.Serial.Fido2" Style="{StaticResource FormLabel}" Margin="0,8,0,4"/>
                    <TextBox Name="TxtBgSerial"/>
                </StackPanel>

                <Border Style="{StaticResource InfoBox}" Background="#F1F5F9" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock FontSize="12" Uid="BreakGlass.Info1"/>
                        <TextBlock FontSize="12" Margin="0,4,0,0" Uid="BreakGlass.Info2"/>
                        <TextBlock FontSize="12" Margin="0,4,0,0" Uid="BreakGlass.Info3"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Name="BtnBgCancel" Uid="Common.Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                    <Button Name="BtnBgCreate" Uid="BreakGlass.Create" Tag="&#xE710;" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Help flyout -->
        <Border Name="PnlHelp" Style="{StaticResource HelpPanel}" Width="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                        <TextBlock Uid="Help.BreakGlass.Title" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Name="BtnHelpClose" Uid="Help.Close" Style="{StaticResource CloseButton}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Uid="Help.What" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BreakGlass.What" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.When" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BreakGlass.When" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Need" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BreakGlass.Need" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Steps" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BreakGlass.Steps" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Result" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BreakGlass.Result" Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
