<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M365 MFA Administration"
        Height="900" Width="1280" MinHeight="760" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <!-- Styles and colors: UI\Theme.xaml (loaded into the application resources at startup) -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header: title with subtitle and connection state on the left, actions on the right -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Name="BtnTenantReport" Uid="Header.TenantReport" Tag="&#xE9D9;" IsEnabled="False" Style="{StaticResource HeaderButton}" Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="M365 MFA Administration" Foreground="White" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Uid="Header.Subtitle" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Name="TxtConnectionStatus" Text="-" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="·" Foreground="#64748B" FontSize="12" Margin="8,0"/>
                        <TextBlock Name="TxtTenant" Text="Tenant: -" Foreground="#CBD5E1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Update badge: shown only when a newer release exists -->
                    <Button Name="BtnUpdate" Uid="Update.Button" Tag="&#xE896;" Visibility="Collapsed" Background="#B45309"/>
                    <Button Name="BtnHelp" Uid="Header.Help" Tag="&#xE897;" Style="{StaticResource HeaderButton}"/>
                    <!-- Tools menu: the less frequent functions, so that the header stays uncluttered -->
                    <Button Name="BtnTools" Uid="Header.Tools" Tag="&#xE713;" IsEnabled="False" Style="{StaticResource HeaderButton}">
                        <Button.ContextMenu>
                            <ContextMenu Name="MnuTools" FontFamily="Segoe UI" FontSize="13">
                                <MenuItem Name="BtnTotpImport" Uid="Header.TotpImport" Padding="10,6"/>
                                <MenuItem Name="BtnTokenInventory" Uid="Header.TokenInventory" Padding="10,6"/>
                                <MenuItem Name="BtnBulkTap" Uid="Header.BulkTap" Padding="10,6"/>
                                <Separator/>
                                <MenuItem Name="BtnCampaign" Uid="Header.Campaign" Padding="10,6"/>
                                <MenuItem Name="BtnClassify" Uid="Header.Classify" Padding="10,6"/>
                                <Separator/>
                                <MenuItem Name="BtnOffboard" Uid="Header.Offboard" Padding="10,6"/>
                                <Separator/>
                                <MenuItem Name="BtnBreakGlass" Uid="Header.BreakGlass" Padding="10,6"/>
                                <Separator/>
                                <MenuItem Name="BtnSettings" Uid="Header.Settings" Padding="10,6"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ComboBox Name="CmbLanguage" Uid="Header.Language" Width="120" Margin="4" DisplayMemberPath="Name"/>
                    <Button Name="BtnLogin" Uid="Header.Login" Tag="&#xE77B;"/>
                    <Button Name="BtnLogout" Uid="Header.Logout" Tag="&#xE7E8;" IsEnabled="False" Style="{StaticResource HeaderButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: search (results as popup) and MFA methods -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Uid="Search.Group">
                    <Grid Name="SearchPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="TxtSearch" Uid="Search.Box" Margin="4"/>
                        <Button Name="BtnSearch" Uid="Search.Button" Tag="&#xE721;" Grid.Column="1" IsEnabled="False"/>

                        <!-- Search results (or recently used users) drop down below the search box -->
                        <Popup Name="PopUsers" PlacementTarget="{Binding ElementName=SearchPanel}" Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=SearchPanel}"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Margin="0,4,8,8" Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Name="TxtUserHits" Text="" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                                    <DataGrid Name="DgUsers" MaxHeight="320" SelectionMode="Single" HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Users.Col.Name" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Users.Col.Upn" Binding="{Binding UserPrincipalName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Users.Col.Mail" Binding="{Binding Mail}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridCheckBoxColumn Header="Users.Col.Enabled" Binding="{Binding AccountEnabled}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Name="GrpMethods" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.3*" MinHeight="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Name="DgMethods" SelectionMode="Single" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Methods.Col.Type" Binding="{Binding TypeName}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Methods.Col.Name" Binding="{Binding DisplayName}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Methods.Col.Created" Binding="{Binding Created, StringFormat=yyyy-MM-dd HH:mm}" Width="115" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Methods.Col.Details" Binding="{Binding Summary}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Guided empty state: the three steps, the current one is highlighted -->
                        <Border Name="PnlGuide" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Padding="10">
                            <StackPanel>
                                <TextBlock Uid="Steps.Title" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Name="StepDot1" Style="{StaticResource StepDot}">
                                        <TextBlock Name="StepNum1" Text="1" Style="{StaticResource StepNumber}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Name="StepTitle1" Uid="Steps.SignIn.Title" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Uid="Steps.SignIn.Text" Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Name="StepDot2" Style="{StaticResource StepDot}">
                                        <TextBlock Name="StepNum2" Text="2" Style="{StaticResource StepNumber}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Name="StepTitle2" Uid="Steps.Search.Title" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Uid="Steps.Search.Text" Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Name="StepDot3" Style="{StaticResource StepDot}">
                                        <TextBlock Name="StepNum3" Text="3" Style="{StaticResource StepNumber}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Name="StepTitle3" Uid="Steps.Method.Title" Style="{StaticResource StepTitle}"/>
                                        <TextBlock Uid="Steps.Method.Text" Style="{StaticResource StepText}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Uid="Steps.HelpHint" Style="{StaticResource StepText}" Margin="0,16,0,0" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Uid="Methods.AllProperties" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                        <TextBox Grid.Row="2" Name="TxtMethodDetails" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="11" Background="#F8FAFC"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Name="BtnExportUser" Uid="User.Export" Tag="&#xE74E;" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                            <Button Name="BtnRefreshMethods" Uid="Methods.Refresh" Tag="&#xE72C;" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                            <Button Name="BtnDeleteMethod" Uid="Methods.Delete" Tag="&#xE74D;" IsEnabled="False" Style="{StaticResource DangerButton}"/>
                        </WrapPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- Right column: user, configuration, results, log -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <GroupBox Uid="User.Group">
                        <StackPanel>
                            <TextBlock Uid="User.DisplayName" Style="{StaticResource Label}"/>
                            <TextBox Name="TxtSelectedName" Text="-" FontWeight="SemiBold" Style="{StaticResource SelectableText}" Margin="0,2,0,10"/>

                            <TextBlock Uid="User.Upn" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtSelectedUpn" Text="-" Style="{StaticResource SelectableText}"/>
                                <Button Grid.Column="1" Name="BtnCopyUpn" Uid="User.CopyUpn" Tag="&#xE8C8;" Style="{StaticResource CopyButton}"/>
                            </Grid>

                            <TextBlock Uid="User.ObjectId" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtSelectedId" Text="-" Style="{StaticResource SelectableText}"/>
                                <Button Grid.Column="1" Name="BtnCopyId" Uid="User.CopyId" Tag="&#xE8C8;" Style="{StaticResource CopyButton}"/>
                            </Grid>

                            <!-- Account type: human or not a human (set up by administrators, skipped by the campaign) -->
                            <TextBlock Uid="User.AccountType" Style="{StaticResource Label}"/>
                            <ComboBox Name="CmbAccountType" Uid="User.AccountTypeBox" Margin="0,2,0,4" IsEnabled="False">
                                <ComboBoxItem Tag="Unclassified" Uid="AccountType.Unclassified"/>
                                <ComboBoxItem Tag="Human" Uid="AccountType.Human"/>
                                <ComboBoxItem Tag="NonHuman" Uid="AccountType.NonHuman"/>
                            </ComboBox>
                            <TextBlock Name="TxtAccountClassInfo" Text="" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="2,0,0,10"/>

                            <Separator Margin="0,2,0,10"/>

                            <!-- MFA traffic light: the badge explains the rating in its tooltip -->
                            <TextBlock Uid="User.MfaStatus" Style="{StaticResource Label}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Name="BdgMfa" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Help">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Name="DotMfa" Width="10" Height="10" Fill="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Name="TxtMfaLevel" Text="-" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- Shown for users without or with weak MFA -->
                                <Button Grid.Column="1" Name="BtnSendGuide" Uid="Guide.Button" Tag="&#xE715;" Visibility="Collapsed"
                                        Padding="10,5" Margin="8,0,0,0" FontSize="12"/>
                            </Grid>
                            <TextBlock Name="TxtMfaHints" Text="" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"/>
                            <TextBlock Name="TxtGuideStatus" Text="" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"/>
                            <Border Height="10"/>

                            <!-- Administrative roles -->
                            <TextBlock Uid="User.AdminRoles" Style="{StaticResource Label}" Margin="0,4,0,0"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="TxtRoleSummary" Text="-" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnShowRoles" Uid="User.ShowRoles" Style="{StaticResource CopyButton}" Visibility="Collapsed"/>
                            </Grid>
                            <ItemsControl Name="LstRoles" Visibility="Collapsed" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoleName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="11" Foreground="#64748B">
                                                    <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Scope, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Administrators: are they excluded from Conditional Access (break-glass check)? -->
                            <Button Name="BtnCheckCa" Uid="User.CheckCa" Tag="&#xE8D7;" Visibility="Collapsed" HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="12" Margin="0,0,0,10"/>

                            <TextBlock Uid="User.MethodCount" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtMethodCount" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Uid="User.PreferredMethod" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtPreferredMethod" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Uid="User.SystemPreferred" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtSystemPreferred" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Uid="User.LastSignIn" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="TxtLastSignIn" Text="-" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnHistory" Uid="User.History" Tag="&#xE823;" Style="{StaticResource CopyButton}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Uid="Config.Group">
                        <StackPanel>
                            <!-- Method cards: Tag = language-independent method ID for Invoke-MfaProvisioning -->
                            <ListBox Name="LstMethod" Style="{StaticResource MethodList}" Margin="4,0">
                                <ListBoxItem Tag="Fido2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                                        <StackPanel>
                                            <TextBlock Uid="Method.Fido2" FontWeight="SemiBold"/>
                                            <TextBlock Uid="Method.Fido2.Desc" Style="{StaticResource StepText}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="FixedTotp">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C3;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                                        <StackPanel>
                                            <TextBlock Uid="Method.FixedTotp" FontWeight="SemiBold"/>
                                            <TextBlock Uid="Method.FixedTotp.Desc" Style="{StaticResource StepText}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="ProgrammableTotp">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                                        <StackPanel>
                                            <TextBlock Uid="Method.ProgrammableTotp" FontWeight="SemiBold"/>
                                            <TextBlock Uid="Method.ProgrammableTotp.Desc" Style="{StaticResource StepText}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="Tap">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                                        <StackPanel>
                                            <TextBlock Uid="Method.Tap" FontWeight="SemiBold"/>
                                            <TextBlock Uid="Method.Tap.Desc" Style="{StaticResource StepText}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="FakeMfa">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                                        <StackPanel>
                                            <TextBlock Uid="Method.FakeMfa" FontWeight="SemiBold"/>
                                            <TextBlock Uid="Method.FakeMfa.Desc" Style="{StaticResource StepText}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ListBoxItem>
                            </ListBox>

                            <!-- Warning when the tenant policy does not allow the selected method -->
                            <Border Name="PnlPolicyWarning" Visibility="Collapsed" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="4,8,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="#92400E" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                    <TextBlock Name="TxtPolicyWarning" Text="" FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Name="PnlSerial" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Name="LblSerial" Style="{StaticResource Label}"/>
                                <TextBox Name="TxtSerial" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Name="PnlSecret" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Uid="Config.Secret" Style="{StaticResource Label}"/>
                                <PasswordBox Name="PwdSecret" Margin="0,4,0,0"/>
                                <!-- Live check of the secret (Base32, length) -->
                                <TextBlock Name="TxtSecretStatus" Text="" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Uid="Import.Algorithm" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <ComboBox Name="CmbTotpAlgorithm" Uid="Import.AlgorithmBox" Margin="0,4,0,0" SelectedIndex="0">
                                            <ComboBoxItem Tag="hmacsha1" Content="SHA-1"/>
                                            <ComboBoxItem Tag="hmacsha256" Content="SHA-256"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Uid="Import.TimeStep" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <ComboBox Name="CmbTotpTimeStep" Uid="Import.TimeStepBox" Margin="0,4,0,0" SelectedIndex="0">
                                            <ComboBoxItem Tag="30" Content="30 s"/>
                                            <ComboBoxItem Tag="60" Content="60 s"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!-- Fake MFA: public hrdnr key of the tenant (optional) -> secret stored encrypted for hrdnr -->
                            <StackPanel Name="PnlHrdnrKey" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Uid="Config.HrdnrKey" Style="{StaticResource Label}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="TxtHrdnrKey" FontFamily="Consolas"/>
                                    <Button Grid.Column="1" Name="BtnLoadHrdnrKey" Uid="Config.HrdnrKey.Load" Tag="&#xE896;" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Name="TxtHrdnrKeyStatus" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- What happens next, as numbered steps -->
                            <Border Name="PnlMethodHint" Style="{StaticResource InfoBox}" Margin="4,12,4,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Uid="Config.HintTitle" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Primary}" Margin="0,0,0,4"/>
                                    <TextBlock Name="TxtMethodHint" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                            <Button Name="BtnExecute" Uid="Config.Start" Tag="&#xE768;" IsEnabled="False" Margin="4,12,4,4" Style="{StaticResource SuccessButton}"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Result: Temporary Access Pass -->
                    <Border Name="PnlTap" Style="{StaticResource ResultCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Uid="Tap.Title" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Name="BtnHideTap" Uid="Tap.Hide" Style="{StaticResource CloseButton}"/>
                            </Grid>
                            <TextBlock Name="TxtTapUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtTapValue" IsReadOnly="True" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                         Padding="8,6" Background="White" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnCopyTap" Uid="Common.Copy" Tag="&#xE8C8;" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="TxtTapValidity" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Uid="Tap.Note" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Result: programmable TOTP card -->
                    <Border Name="PnlTotp" Style="{StaticResource ResultCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Uid="Totp.Title" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Name="BtnHideTotp" Uid="Totp.Hide" Style="{StaticResource CloseButton}"/>
                            </Grid>
                            <TextBlock Name="TxtTotpUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                            <Border Background="White" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8">
                                <Image Name="ImgTotpQr" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <TextBlock Uid="Totp.Secret" Style="{StaticResource Label}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtTotpSecret" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                         Padding="6,6" Background="White" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnCopyTotpSecret" Uid="Common.Copy" Tag="&#xE8C8;" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="TxtTotpInfo" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Button Name="BtnSaveTotpQr" Uid="Totp.SaveQr" Tag="&#xE74E;" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"/>
                            <TextBlock Uid="Totp.Note" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <GroupBox Uid="Log.Group" Height="270" Margin="0" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                <Button Name="BtnLogCopy" Uid="Log.Copy" Tag="&#xE8C8;" Style="{StaticResource CopyButton}" IsEnabled="True"/>
                                <Button Name="BtnLogSave" Uid="Log.Save" Tag="&#xE74E;" Style="{StaticResource CopyButton}" IsEnabled="True"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" Name="LstLog" Style="{StaticResource LogList}" SelectionMode="Extended"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Toast: short confirmation at the bottom right, disappears by itself -->
            <Border Name="PnlToast" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="#0F172A" CornerRadius="6" Padding="14,10" Margin="0,0,8,8" MaxWidth="520">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="TxtToastIcon" Text="&#xE8FB;" Style="{StaticResource Glyph}" Foreground="#4ADE80" FontSize="16"/>
                    <TextBlock Name="TxtToast" Text="" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer with progress bar -->
        <Grid Grid.Row="2">
            <ProgressBar Name="ProgressBar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
            <TextBlock Uid="Footer.Notice"
                       FontSize="11" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Busy overlay: blocks the window while Graph is working and says what is going on -->
        <Border Name="PnlBusy" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="#B3F3F5F8">
            <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="24,18"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Name="Spinner" Style="{StaticResource Spinner}" Margin="0,0,16,0">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Name="TxtBusy" Text="" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Help flyout -->
        <Border Name="PnlHelp" Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource HelpPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                        <TextBlock Uid="Help.Main.Title" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Name="BtnHelpClose" Uid="Help.Close" Style="{StaticResource CloseButton}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Uid="Help.What" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Main.What" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Steps" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Main.Steps" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Methods" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Main.Methods" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Need" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Main.Need" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Tools" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Main.Tools" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Result" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Main.Result" Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Welcome overlay on the first start -->
        <Border Name="PnlWelcome" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Background="#99000000">
            <Border Background="White" CornerRadius="10" Padding="30,26" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Uid="Welcome.Title" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Uid="Welcome.Intro" Style="{StaticResource HelpText}" Margin="0,8,0,16"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StepDot}" Background="{StaticResource Primary}"><TextBlock Text="1" Style="{StaticResource StepNumber}" Foreground="White"/></Border>
                        <StackPanel Width="500">
                            <TextBlock Uid="Steps.SignIn.Title" Style="{StaticResource StepTitle}"/>
                            <TextBlock Uid="Welcome.Step1" Style="{StaticResource StepText}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StepDot}" Background="{StaticResource Primary}"><TextBlock Text="2" Style="{StaticResource StepNumber}" Foreground="White"/></Border>
                        <StackPanel Width="500">
                            <TextBlock Uid="Steps.Search.Title" Style="{StaticResource StepTitle}"/>
                            <TextBlock Uid="Welcome.Step2" Style="{StaticResource StepText}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StepDot}" Background="{StaticResource Primary}"><TextBlock Text="3" Style="{StaticResource StepNumber}" Foreground="White"/></Border>
                        <StackPanel Width="500">
                            <TextBlock Uid="Steps.Method.Title" Style="{StaticResource StepTitle}"/>
                            <TextBlock Uid="Welcome.Step3" Style="{StaticResource StepText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource InfoBox}" Margin="0,8,0,16">
                        <TextBlock Uid="Welcome.Tip" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Name="ChkWelcomeDontShow" Uid="Welcome.DontShow"/>
                        <Button Grid.Column="1" Name="BtnWelcomeStart" Uid="Welcome.Start" Tag="&#xE768;"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
