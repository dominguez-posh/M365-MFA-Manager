<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M365 MFA Administration"
        Height="900" Width="1280" MinHeight="760" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="Primary" Color="#0067B8"/>
        <SolidColorBrush x:Key="Secondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>
        <SolidColorBrush x:Key="Text" Color="#242424"/>
        <SolidColorBrush x:Key="MutedText" Color="#64748B"/>
        <SolidColorBrush x:Key="Border" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="ResultBackground" Color="#FFF8E1"/>
        <SolidColorBrush x:Key="ResultBorder" Color="#F2C94C"/>

        <!-- Default styles -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <!-- Tables: flat, white, subtle lines and selection -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Named styles -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Secondary}"/>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#334155"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ResultCard" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="{StaticResource ResultBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ResultBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Name="BtnTenantReport" Uid="Header.TenantReport" IsEnabled="False" Style="{StaticResource HeaderButton}"
                        VerticalAlignment="Center" Margin="0,0,20,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="M365 MFA Administration" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Uid="Header.Subtitle" Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Name="TxtConnectionStatus" Text="-" Foreground="#FCA5A5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Name="TxtTenant" Text="Tenant: -" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnTotpImport" Uid="Header.TotpImport" IsEnabled="False" Style="{StaticResource HeaderButton}"/>
                    <Button Name="BtnBreakGlass" Uid="Header.BreakGlass" IsEnabled="False" Style="{StaticResource HeaderButton}"/>
                    <ComboBox Name="CmbLanguage" Uid="Header.Language" Width="120" Margin="4" Padding="8,7" VerticalContentAlignment="Center"
                              DisplayMemberPath="Name"/>
                    <Button Name="BtnLogin" Uid="Header.Login"/>
                    <Button Name="BtnLogout" Uid="Header.Logout" IsEnabled="False" Style="{StaticResource HeaderButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: search (results as popup) and MFA methods -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Uid="Search.Group">
                    <Grid Name="SearchPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="TxtSearch" Uid="Search.Box" Margin="4"/>
                        <Button Name="BtnSearch" Uid="Search.Button" Grid.Column="1" IsEnabled="False"/>

                        <!-- Search results drop down below the search box -->
                        <Popup Name="PopUsers" PlacementTarget="{Binding ElementName=SearchPanel}" Placement="Bottom"
                               Width="{Binding ActualWidth, ElementName=SearchPanel}"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Margin="0,4,8,8" Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Name="TxtUserHits" Text="" Style="{StaticResource Label}" Margin="2,0,0,6"/>
                                    <DataGrid Name="DgUsers" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Users.Col.Name" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Users.Col.Upn" Binding="{Binding UserPrincipalName}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="Users.Col.Mail" Binding="{Binding Mail}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridCheckBoxColumn Header="Users.Col.Enabled" Binding="{Binding AccountEnabled}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Name="GrpMethods" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.3*" MinHeight="140"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid Name="DgMethods">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Methods.Col.Type" Binding="{Binding TypeName}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Methods.Col.Name" Binding="{Binding DisplayName}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Methods.Col.Created" Binding="{Binding Created, StringFormat=yyyy-MM-dd HH:mm}" Width="115" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Methods.Col.Details" Binding="{Binding Summary}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Name="TxtNoUser" Uid="Methods.NoUser"
                                   Style="{StaticResource Label}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Uid="Methods.AllProperties" Style="{StaticResource Label}" Margin="0,10,0,4"/>
                        <TextBox Grid.Row="2" Name="TxtMethodDetails" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="11" Background="#F8FAFC"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Name="BtnRefreshMethods" Uid="Methods.Refresh" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                            <Button Name="BtnDeleteMethod" Uid="Methods.Delete" IsEnabled="False" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- Right column: user, configuration, results, log -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <GroupBox Uid="User.Group">
                        <StackPanel>
                            <TextBlock Uid="User.DisplayName" Style="{StaticResource Label}"/>
                            <TextBox Name="TxtSelectedName" Text="-" FontWeight="SemiBold" Style="{StaticResource SelectableText}" Margin="0,2,0,10"/>

                            <TextBlock Uid="User.Upn" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtSelectedUpn" Text="-" Style="{StaticResource SelectableText}"/>
                                <Button Grid.Column="1" Name="BtnCopyUpn" Uid="User.CopyUpn" Style="{StaticResource CopyButton}"/>
                            </Grid>

                            <TextBlock Uid="User.ObjectId" Style="{StaticResource Label}"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtSelectedId" Text="-" Style="{StaticResource SelectableText}"/>
                                <Button Grid.Column="1" Name="BtnCopyId" Uid="User.CopyId" Style="{StaticResource CopyButton}"/>
                            </Grid>

                            <Separator Margin="0,2,0,10"/>

                            <!-- MFA traffic light -->
                            <TextBlock Uid="User.MfaStatus" Style="{StaticResource Label}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Name="BdgMfa" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Name="DotMfa" Width="10" Height="10" Fill="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock Name="TxtMfaLevel" Text="-" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <!-- Shown for users without or with weak MFA -->
                                <Button Grid.Column="1" Name="BtnSendGuide" Uid="Guide.Button" Visibility="Collapsed"
                                        Padding="10,5" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Name="TxtMfaHints" Text="" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"/>
                            <TextBlock Name="TxtGuideStatus" Text="" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"/>
                            <Border Height="10"/>

                            <!-- Administrative roles -->
                            <TextBlock Uid="User.AdminRoles" Style="{StaticResource Label}" Margin="0,4,0,0"/>
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="TxtRoleSummary" Text="-" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnShowRoles" Uid="User.ShowRoles" Style="{StaticResource CopyButton}" Visibility="Collapsed"/>
                            </Grid>
                            <ItemsControl Name="LstRoles" Visibility="Collapsed" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" BorderBrush="#E1E5EA" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RoleName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="11" Foreground="#64748B">
                                                    <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Scope, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Uid="User.MethodCount" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtMethodCount" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Uid="User.PreferredMethod" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtPreferredMethod" Text="-" Margin="0,2,0,10"/>
                            <TextBlock Uid="User.SystemPreferred" Style="{StaticResource Label}"/>
                            <TextBlock Name="TxtSystemPreferred" Text="-" Margin="0,2,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Uid="Config.Group">
                        <StackPanel>
                            <ComboBox Name="CmbMethod" Padding="8" Margin="4">
                                <!-- Tag = language-independent method ID for Invoke-MfaProvisioning -->
                                <ComboBoxItem Tag="Fido2" Uid="Method.Fido2"/>
                                <ComboBoxItem Tag="FixedTotp" Uid="Method.FixedTotp"/>
                                <ComboBoxItem Tag="ProgrammableTotp" Uid="Method.ProgrammableTotp"/>
                                <ComboBoxItem Tag="Tap" Uid="Method.Tap"/>
                                <ComboBoxItem Tag="FakeMfa" Uid="Method.FakeMfa"/>
                            </ComboBox>
                            <StackPanel Name="PnlSerial" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Name="LblSerial" Style="{StaticResource Label}"/>
                                <TextBox Name="TxtSerial" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Name="PnlSecret" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Uid="Config.Secret" Style="{StaticResource Label}"/>
                                <PasswordBox Name="PwdSecret" Margin="0,4,0,0" Padding="10,8" BorderBrush="{StaticResource Border}"/>
                            </StackPanel>
                            <!-- Fake MFA: public hrdnr key of the tenant (optional) -> secret stored encrypted for hrdnr -->
                            <StackPanel Name="PnlHrdnrKey" Visibility="Collapsed" Margin="4,10,4,0">
                                <TextBlock Uid="Config.HrdnrKey" Style="{StaticResource Label}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="TxtHrdnrKey" FontFamily="Consolas"/>
                                    <Button Grid.Column="1" Name="BtnLoadHrdnrKey" Uid="Config.HrdnrKey.Load" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Name="TxtHrdnrKeyStatus" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Name="TxtMethodHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="4,10,4,0"/>
                            <Button Name="BtnExecute" Uid="Config.Start" IsEnabled="False" Margin="4,12,4,4"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Result: Temporary Access Pass -->
                    <Border Name="PnlTap" Style="{StaticResource ResultCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Uid="Tap.Title" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Name="BtnHideTap" Uid="Tap.Hide" Style="{StaticResource CloseButton}"/>
                            </Grid>
                            <TextBlock Name="TxtTapUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtTapValue" IsReadOnly="True" FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                                         Padding="8,6" Background="White" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnCopyTap" Uid="Common.Copy" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="TxtTapValidity" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Uid="Tap.Note" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Result: programmable TOTP card -->
                    <Border Name="PnlTotp" Style="{StaticResource ResultCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Uid="Totp.Title" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Name="BtnHideTotp" Uid="Totp.Hide" Style="{StaticResource CloseButton}"/>
                            </Grid>
                            <TextBlock Name="TxtTotpUser" Text="-" Style="{StaticResource Label}" Margin="0,2,0,8"/>
                            <Border Background="White" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,8">
                                <Image Name="ImgTotpQr" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <TextBlock Uid="Totp.Secret" Style="{StaticResource Label}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="TxtTotpSecret" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                         Padding="6,6" Background="White" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Name="BtnCopyTotpSecret" Uid="Common.Copy" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Name="TxtTotpInfo" Text="-" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Button Name="BtnSaveTotpQr" Uid="Totp.SaveQr" HorizontalAlignment="Left" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"/>
                            <TextBlock Uid="Totp.Note"
                                       Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <GroupBox Uid="Log.Group" Height="240" Margin="0">
                        <TextBox Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer with progress bar -->
        <Grid Grid.Row="2">
            <ProgressBar Name="ProgressBar" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
            <TextBlock Uid="Footer.Notice"
                       FontSize="11" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
