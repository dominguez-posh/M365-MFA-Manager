<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="Settings.Title"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,18,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border Background="{StaticResource HeaderBackground}" Padding="24,16">
            <StackPanel>
                <TextBlock Uid="Settings.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Uid="Settings.Subtitle" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,0,24,20">
            <TextBlock Uid="Settings.Section.Totp" Style="{StaticResource Section}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Uid="Import.Algorithm" Style="{StaticResource FormLabel}"/>
                    <ComboBox Name="CmbSetAlgorithm" Uid="Import.AlgorithmBox" SelectedIndex="0">
                        <ComboBoxItem Tag="hmacsha1" Content="SHA-1"/>
                        <ComboBoxItem Tag="hmacsha256" Content="SHA-256"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Uid="Import.TimeStep" Style="{StaticResource FormLabel}"/>
                    <ComboBox Name="CmbSetTimeStep" Uid="Import.TimeStepBox" SelectedIndex="0">
                        <ComboBoxItem Tag="30" Content="30 s"/>
                        <ComboBoxItem Tag="60" Content="60 s"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Uid="Settings.Section.Tap" Style="{StaticResource Section}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Uid="BulkTap.Lifetime" Style="{StaticResource FormLabel}"/>
                    <TextBox Name="TxtSetTapLifetime" Uid="BulkTap.LifetimeBox" Text="480"/>
                </StackPanel>
                <CheckBox Grid.Column="2" Name="ChkSetTapOnce" Uid="BulkTap.UsableOnce" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
            </Grid>

            <TextBlock Uid="Settings.Section.Mail" Style="{StaticResource Section}"/>
            <TextBlock Uid="Guide.From" Style="{StaticResource FormLabel}"/>
            <TextBox Name="TxtSetGuideSender" Uid="Guide.FromBox"/>

            <TextBlock Uid="Settings.Section.SignIn" Style="{StaticResource Section}"/>
            <TextBlock Uid="Settings.TenantId" Style="{StaticResource FormLabel}"/>
            <TextBox Name="TxtSetTenantId" Uid="Settings.TenantIdBox" FontFamily="Consolas"/>

            <TextBlock Uid="Settings.Section.App" Style="{StaticResource Section}"/>
            <CheckBox Name="ChkSetWelcome" Uid="Settings.ShowWelcome" Margin="0,12,0,0"/>
            <TextBlock Uid="Settings.LogFolder" Style="{StaticResource FormLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="TxtSetLogFolder" IsReadOnly="True" Background="#F8FAFC"/>
                <Button Grid.Column="1" Name="BtnSetOpenLog" Uid="Settings.OpenLog" Tag="&#xE8B7;" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"/>
            </Grid>
            <TextBlock Name="TxtSetPath" Text="" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Name="BtnSetCancel" Uid="Common.Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                <Button Name="BtnSetSave" Uid="Settings.Save" Tag="&#xE74E;" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
