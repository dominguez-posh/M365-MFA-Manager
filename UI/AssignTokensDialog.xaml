<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="Inventory.BulkAssign.Title"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#0067B8"/>
        <SolidColorBrush x:Key="MutedText" Color="#64748B"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#64748B"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#242424"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border Background="#0F172A" Padding="24,16">
            <StackPanel>
                <TextBlock Uid="Inventory.BulkAssign.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Name="TxtAtFree" Text="" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,6,24,20">
            <TextBlock Uid="BulkTap.Source" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <RadioButton Name="RbAtGroup" GroupName="AtSource" Uid="BulkTap.Source.Group" IsChecked="True"/>
                <RadioButton Name="RbAtCsv" GroupName="AtSource" Uid="BulkTap.Source.Csv"/>
            </StackPanel>
            <StackPanel Name="PnlAtGroup" Orientation="Horizontal">
                <TextBox Name="TxtAtGroupSearch" Uid="Report.GroupSearch" Width="200" Margin="0,4,0,4"/>
                <Button Name="BtnAtFindGroup" Uid="Report.FindGroup" Style="{StaticResource SecondaryButton}"/>
                <ComboBox Name="CmbAtGroup" Width="250" Padding="8,7" Margin="8,4,0,4" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName"/>
            </StackPanel>
            <Grid Name="PnlAtCsv" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="TxtAtFile" IsReadOnly="True" Margin="0,4,0,4" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Name="BtnAtBrowse" Uid="Import.Browse" Style="{StaticResource SecondaryButton}"/>
            </Grid>

            <Border Background="#F1F5F9" CornerRadius="4" Padding="12,10" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock FontSize="12" Uid="Inventory.BulkAssign.Info1"/>
                    <TextBlock FontSize="12" Margin="0,4,0,0" Uid="Inventory.BulkAssign.Info2"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Name="BtnAtCancel" Uid="Common.Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                <Button Name="BtnAtStart" Uid="Inventory.BulkAssign.Start" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
