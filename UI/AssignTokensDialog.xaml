<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="Inventory.BulkAssign.Title"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="White" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <Border Background="{StaticResource HeaderBackground}" Padding="24,16">
            <StackPanel>
                <TextBlock Uid="Inventory.BulkAssign.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Name="TxtAtFree" Text="" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,6,24,20">
            <TextBlock Uid="BulkTap.Source" Style="{StaticResource FormLabel}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <RadioButton Name="RbAtGroup" GroupName="AtSource" Uid="BulkTap.Source.Group" IsChecked="True"/>
                <RadioButton Name="RbAtCsv" GroupName="AtSource" Uid="BulkTap.Source.Csv"/>
            </StackPanel>
            <StackPanel Name="PnlAtGroup" Orientation="Horizontal">
                <TextBox Name="TxtAtGroupSearch" Uid="Report.GroupSearch" Width="200" Margin="0,4,0,4"/>
                <Button Name="BtnAtFindGroup" Uid="Report.FindGroup" Tag="&#xE721;" Style="{StaticResource SecondaryButton}"/>
                <ComboBox Name="CmbAtGroup" Width="250" Margin="8,4,0,4" DisplayMemberPath="DisplayName"/>
            </StackPanel>
            <Grid Name="PnlAtCsv" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="TxtAtFile" IsReadOnly="True" Margin="0,4,0,4"/>
                <Button Grid.Column="1" Name="BtnAtBrowse" Uid="Import.Browse" Tag="&#xE8E5;" Style="{StaticResource SecondaryButton}"/>
            </Grid>

            <Border Style="{StaticResource InfoBox}" Background="#F1F5F9" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock FontSize="12" Uid="Inventory.BulkAssign.Info1"/>
                    <TextBlock FontSize="12" Margin="0,4,0,0" Uid="Inventory.BulkAssign.Info2"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Name="BtnAtCancel" Uid="Common.Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
                <Button Name="BtnAtStart" Uid="Inventory.BulkAssign.Start" Tag="&#xE716;" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
