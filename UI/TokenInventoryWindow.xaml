<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="Inventory.Title"
        Height="680" Width="1150" MinHeight="460" MinWidth="860"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}" FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Uid="Inventory.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Name="TxtInvTenant" Text="" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Name="BtnHelp" Uid="Header.Help" Tag="&#xE897;" Style="{StaticResource HeaderButton}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Name="TxtInvSearch" Uid="Inventory.Search" Margin="0,4,4,4"/>
            <ComboBox Grid.Column="1" Name="CmbInvFilter" Uid="Inventory.FilterBox" Width="200" Margin="4" SelectedIndex="0">
                <ComboBoxItem Uid="Inventory.Filter.All" Tag="All"/>
                <ComboBoxItem Uid="Inventory.Filter.Free" Tag="Free"/>
                <ComboBoxItem Uid="Inventory.Filter.Assigned" Tag="Assigned"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Name="TxtInvCount" Text="" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource MutedText}"/>
            <Button Grid.Column="3" Name="BtnInvRefresh" Uid="Inventory.Refresh" Tag="&#xE72C;" Style="{StaticResource SecondaryButton}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,0">
            <DataGrid Name="DgInv">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Inventory.Col.Serial" Binding="{Binding SerialNumber}" Width="150"/>
                    <DataGridTemplateColumn Header="Inventory.Col.Status" Width="120" SortMemberPath="Status" CellTemplate="{StaticResource StatusChip}"/>
                    <DataGridTextColumn Header="Inventory.Col.AssignedTo" Binding="{Binding AssignedToName}" Width="220"/>
                    <DataGridTextColumn Header="Inventory.Col.Model" Binding="{Binding Model}" Width="170"/>
                    <DataGridTextColumn Header="Inventory.Col.Manufacturer" Binding="{Binding Manufacturer}" Width="130"/>
                    <DataGridTextColumn Header="Inventory.Col.Algorithm" Binding="{Binding Algorithm}" Width="90"/>
                    <DataGridTextColumn Header="Inventory.Col.Interval" Binding="{Binding TimeInterval}" Width="80"/>
                    <DataGridTextColumn Header="Inventory.Col.DisplayName" Binding="{Binding DisplayName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Name="TxtInvEmpty" Uid="Inventory.Empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedText}" Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="20,10,20,16">
            <TextBlock Name="TxtInvStatus" Text="" TextWrapping="Wrap"/>
            <ProgressBar Name="PrgInv" Height="4" Margin="0,6,0,0" Visibility="Hidden" IsIndeterminate="True"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Name="BtnInvBulkAssign" Uid="Inventory.BulkAssign" Tag="&#xE716;" Style="{StaticResource SecondaryButton}"/>
                <Button Name="BtnInvAssign" Uid="Inventory.Assign" Tag="&#xE710;"/>
                <Button Name="BtnInvActivate" Uid="Inventory.Activate" Tag="&#xE8FB;"/>
                <Button Name="BtnInvUnassign" Uid="Inventory.Unassign" Tag="&#xE738;" Style="{StaticResource SecondaryButton}"/>
                <Button Name="BtnInvDelete" Uid="Inventory.Delete" Tag="&#xE74D;" Style="{StaticResource DangerButton}"/>
                <Button Name="BtnInvClose" Uid="Common.Close" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </WrapPanel>
        </StackPanel>

        <!-- Help flyout -->
        <Border Name="PnlHelp" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource HelpPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                        <TextBlock Uid="Help.Inventory.Title" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Name="BtnHelpClose" Uid="Help.Close" Style="{StaticResource CloseButton}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Uid="Help.What" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Inventory.What" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.When" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Inventory.When" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Need" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Inventory.Need" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Steps" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Inventory.Steps" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Result" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Inventory.Result" Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
