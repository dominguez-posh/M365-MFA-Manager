<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="Report.Title"
        Height="860" Width="1360" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,4,0"/>
        </Style>

        <!-- Traffic light tiles (also the level filter) -->
        <Style x:Key="Tile" TargetType="RadioButton">
            <Setter Property="GroupName" Value="LevelFilter"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="6" Padding="14,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Text" Value="0"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="24,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Uid="Report.Title" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Uid="Report.Subtitle" Foreground="#CBD5E1" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Name="TxtRptTenant" Text="-" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Grid.Column="2" Name="BtnHelp" Uid="Header.Help" Tag="&#xE897;" Style="{StaticResource HeaderButton}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Scope and start -->
            <GroupBox Grid.Row="0" Uid="Report.ScopeGroup">
                <WrapPanel VerticalAlignment="Center">
                    <ComboBox Name="CmbRptScope" Uid="Report.ScopeBox" Width="300" Margin="4">
                        <ComboBoxItem Tag="All" Uid="Report.Scope.All" IsSelected="True"/>
                        <ComboBoxItem Tag="Group" Uid="Report.Scope.Members"/>
                    </ComboBox>
                    <StackPanel Name="PnlRptGroup" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox Name="TxtRptGroupSearch" Uid="Report.GroupSearch" Width="200" Margin="4"/>
                        <Button Name="BtnRptFindGroup" Uid="Report.FindGroup" Tag="&#xE721;" Style="{StaticResource SecondaryButton}"/>
                        <ComboBox Name="CmbRptGroup" Width="260" Margin="4" DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                    <CheckBox Name="ChkRptEnabledOnly" Uid="Report.EnabledOnly" IsChecked="True"/>
                    <CheckBox Name="ChkRptGuests" Uid="Report.IncludeGuests"/>
                    <Button Name="BtnRptStart" Uid="Report.Start" Tag="&#xE768;" Margin="16,4,4,4"/>
                    <Button Name="BtnRptCancel" Uid="Common.Cancel" Tag="&#xE711;" IsEnabled="False" Style="{StaticResource SecondaryButton}"/>
                </WrapPanel>
            </GroupBox>

            <!-- Traffic light tiles = level filter -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <RadioButton Name="RbRptAll" Uid="Report.Filter.All" Style="{StaticResource Tile}" IsChecked="True">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Uid="Report.Tile.All" Style="{StaticResource TileLabel}"/>
                        </StackPanel>
                        <TextBlock Name="TxtRptCountAll" Style="{StaticResource TileCount}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Name="RbRptRed" Uid="Report.Filter.Red" Style="{StaticResource Tile}" Background="#FEE2E2" BorderBrush="#FCA5A5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#DC2626" VerticalAlignment="Center"/>
                            <TextBlock Uid="Report.Tile.Red" Style="{StaticResource TileLabel}" Foreground="#991B1B"/>
                        </StackPanel>
                        <TextBlock Name="TxtRptCountRed" Style="{StaticResource TileCount}" Foreground="#991B1B"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Name="RbRptYellow" Uid="Report.Filter.Yellow" Style="{StaticResource Tile}" Background="#FEF3C7" BorderBrush="#FCD34D">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#D97706" VerticalAlignment="Center"/>
                            <TextBlock Uid="Report.Tile.Yellow" Style="{StaticResource TileLabel}" Foreground="#92400E"/>
                        </StackPanel>
                        <TextBlock Name="TxtRptCountYellow" Style="{StaticResource TileCount}" Foreground="#92400E"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Name="RbRptGreen" Uid="Report.Filter.Green" Style="{StaticResource Tile}" Background="#DCFCE7" BorderBrush="#86EFAC">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#16A34A" VerticalAlignment="Center"/>
                            <TextBlock Uid="Report.Tile.Green" Style="{StaticResource TileLabel}" Foreground="#166534"/>
                        </StackPanel>
                        <TextBlock Name="TxtRptCountGreen" Style="{StaticResource TileCount}" Foreground="#166534"/>
                    </StackPanel>
                </RadioButton>
                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="2" CornerRadius="6" Padding="14,8" MinWidth="170"
                        Uid="Report.Tile.AdminsRedBox">
                    <StackPanel>
                        <TextBlock Uid="Report.Tile.AdminsRed" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedText}"/>
                        <TextBlock Name="TxtRptCountAdminsRed" Style="{StaticResource TileCount}" Foreground="#991B1B"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="2" CornerRadius="6" Padding="14,8" MinWidth="170" Margin="10,0,0,0"
                        Uid="Report.Tile.InactiveBox">
                    <StackPanel>
                        <TextBlock Name="TxtRptInactiveLabel" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedText}"/>
                        <TextBlock Name="TxtRptCountInactive" Style="{StaticResource TileCount}" Foreground="#334155"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Search, filters and export -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MaxWidth="460"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Uid="Report.Search" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Name="TxtRptSearch" Uid="Report.SearchBox" Margin="4"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Name="ChkRptAdminsOnly" Uid="Report.AdminsOnly"/>
                    <CheckBox Name="ChkRptInactiveOnly" Uid="Report.InactiveOnlyBox"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Uid="Report.DoubleClickHint" Style="{StaticResource Label}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="16,0,10,0"/>
                <TextBlock Grid.Column="4" Name="TxtRptVisible" Text="" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="5" Name="BtnRptExport" Uid="Report.Export" Tag="&#xE74E;" IsEnabled="False" Style="{StaticResource SuccessButton}"/>
            </Grid>

            <DataGrid Grid.Row="3" Name="DgRpt">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Report.Col.Status" Width="120" SortMemberPath="LevelOrder" CellTemplate="{StaticResource LevelChip}"/>
                    <DataGridTextColumn Header="Report.Col.Reason" Binding="{Binding Reason}" Width="300" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Name" Binding="{Binding DisplayName}" Width="190" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Upn" Binding="{Binding UserPrincipalName}" Width="240" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.LastSignIn" Binding="{Binding LastSignInText}" SortMemberPath="LastSignIn" Width="130" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.DaysSinceSignIn" Binding="{Binding DaysText}" SortMemberPath="DaysSort" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                        <Setter Property="Foreground" Value="#991B1B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Report.Col.Roles" Binding="{Binding AdminRoles}" Width="220" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Methods" Binding="{Binding Methods}" Width="260" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.GuideSent" Binding="{Binding GuideSentText}" SortMemberPath="GuideSentAt" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding GuideHistoryText}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Report.Col.GuideCount" Binding="{Binding GuideCount}" Width="70" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.MethodCount" Binding="{Binding MethodCount}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Report.Col.Enabled" Binding="{Binding AccountEnabled, Mode=OneWay}" Width="60"/>
                    <DataGridCheckBoxColumn Header="Report.Col.Licensed" Binding="{Binding IsLicensed, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="Report.Col.UserType" Binding="{Binding UserType}" Width="80" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Department" Binding="{Binding Department}" Width="140" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.PasswordLastSet" Binding="{Binding PasswordLastSet}" Width="130" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Report.Col.Mail" Binding="{Binding Mail}" Width="220" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Name="TxtRptEmpty" Uid="Report.Status.Ready" Style="{StaticResource Label}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Footer: progress -->
        <Grid Grid.Row="2" Margin="20,0,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Name="PrgRpt" Height="8" VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Hidden"/>
            <TextBlock Grid.Column="1" Name="TxtRptStatus" Text="" Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- Help flyout -->
        <Border Name="PnlHelp" Grid.Row="1" Grid.RowSpan="2" Style="{StaticResource HelpPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                        <TextBlock Uid="Help.Report.Title" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Name="BtnHelpClose" Uid="Help.Close" Style="{StaticResource CloseButton}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Uid="Help.What" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Report.What" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.When" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Report.When" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Need" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Report.Need" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Steps" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Report.Steps" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Result" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.Report.Result" Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
