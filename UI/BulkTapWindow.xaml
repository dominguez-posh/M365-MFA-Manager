<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="BulkTap.Title"
        Height="720" Width="1100" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Uid="BulkTap.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Name="TxtBtTenant" Text="" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Name="BtnHelp" Uid="Header.Help" Tag="&#xE897;" Style="{StaticResource HeaderButton}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16,20,0">
            <TextBlock Uid="BulkTap.Source" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <RadioButton Name="RbBtCsv" GroupName="BtSource" Uid="BulkTap.Source.Csv" IsChecked="True"/>
                <RadioButton Name="RbBtGroup" GroupName="BtSource" Uid="BulkTap.Source.Group"/>
            </StackPanel>
            <Grid Name="PnlBtCsv">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="TxtBtFile" IsReadOnly="True" Margin="0,4,4,4"/>
                <Button Grid.Column="1" Name="BtnBtBrowse" Uid="Import.Browse" Tag="&#xE8E5;"/>
            </Grid>
            <StackPanel Name="PnlBtGroup" Orientation="Horizontal" Visibility="Collapsed">
                <TextBox Name="TxtBtGroupSearch" Uid="Report.GroupSearch" Width="260" Margin="0,4,4,4"/>
                <Button Name="BtnBtFindGroup" Uid="Report.FindGroup" Tag="&#xE721;" Style="{StaticResource SecondaryButton}"/>
                <ComboBox Name="CmbBtGroup" Width="320" Margin="4" DisplayMemberPath="DisplayName"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Uid="BulkTap.Lifetime" Style="{StaticResource Label}"/>
                    <TextBox Name="TxtBtLifetime" Uid="BulkTap.LifetimeBox" Text="480" Width="100" Margin="0,4,0,0"/>
                    <!-- Live check: 10 to 43200 minutes -->
                    <TextBlock Name="TxtBtLifetimeHint" Text="" FontSize="11" Margin="0,3,0,0" Foreground="{StaticResource MutedText}"/>
                </StackPanel>
                <CheckBox Name="ChkBtUsableOnce" Uid="BulkTap.UsableOnce" Margin="32,18,0,0" VerticalAlignment="Top"/>
            </StackPanel>

            <Border Style="{StaticResource InfoBox}" Margin="0,14,0,12">
                <StackPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Uid="BulkTap.Info1"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Uid="BulkTap.Info2"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="2" Name="DgBt" Margin="20,0,20,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Import.Col.Line" Binding="{Binding Line}" Width="60"/>
                <DataGridTemplateColumn Header="Import.Col.Status" Width="120" SortMemberPath="Status" CellTemplate="{StaticResource StatusChip}"/>
                <DataGridTextColumn Header="Import.Col.Upn" Binding="{Binding Upn}" Width="240"/>
                <DataGridTextColumn Header="Import.Col.Name" Binding="{Binding DisplayName}" Width="170"/>
                <DataGridTextColumn Header="BulkTap.Col.Tap" Binding="{Binding Pass}" Width="150" ElementStyle="{StaticResource Mono}"/>
                <DataGridTextColumn Header="BulkTap.Col.ValidUntil" Binding="{Binding ValidText}" Width="140"/>
                <DataGridTextColumn Header="Import.Col.Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="20,10,20,16">
            <TextBlock Name="TxtBtStatus" Text="" TextWrapping="Wrap"/>
            <ProgressBar Name="PrgBt" Height="4" Margin="0,6,0,0" Visibility="Hidden"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Name="BtnBtTest" Uid="BulkTap.Test" Tag="&#xE73E;"/>
                <Button Name="BtnBtStart" Uid="BulkTap.Start" Tag="&#xE8D7;" Style="{StaticResource SuccessButton}" IsEnabled="False"/>
                <Button Name="BtnBtExport" Uid="Report.Export" Tag="&#xE74E;" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                <Button Name="BtnBtCancel" Uid="Common.Cancel" Tag="&#xE711;" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                <Button Name="BtnBtClose" Uid="Common.Close" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </WrapPanel>
        </StackPanel>

        <!-- Help flyout -->
        <Border Name="PnlHelp" Grid.Row="1" Grid.RowSpan="3" Style="{StaticResource HelpPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Primary}"/>
                        <TextBlock Uid="Help.BulkTap.Title" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Name="BtnHelpClose" Uid="Help.Close" Style="{StaticResource CloseButton}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Uid="Help.What" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BulkTap.What" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.When" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BulkTap.When" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Need" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BulkTap.Need" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Steps" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BulkTap.Steps" Style="{StaticResource HelpText}"/>
                        <TextBlock Uid="Help.Result" Style="{StaticResource HelpLabel}"/>
                        <TextBlock Uid="Help.BulkTap.Result" Style="{StaticResource HelpText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
