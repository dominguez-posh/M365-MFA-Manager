<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Uid="BulkTap.Title"
        Height="720" Width="1100" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F7FA" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#0067B8"/>
        <SolidColorBrush x:Key="Secondary" Color="#64748B"/>
        <SolidColorBrush x:Key="Text" Color="#242424"/>
        <SolidColorBrush x:Key="MutedText" Color="#64748B"/>
        <SolidColorBrush x:Key="Border" Color="#D0D7DE"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Secondary}"/>
        </Style>
        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#107C41"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFFFFF"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#E1E5EA"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Created">
                    <Setter Property="Background" Value="#DCFCE7"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="24,16">
            <StackPanel>
                <TextBlock Uid="BulkTap.Title" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Name="TxtBtTenant" Text="" Foreground="#CBD5E1" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16,20,0">
            <TextBlock Uid="BulkTap.Source" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <RadioButton Name="RbBtCsv" GroupName="BtSource" Uid="BulkTap.Source.Csv" IsChecked="True"/>
                <RadioButton Name="RbBtGroup" GroupName="BtSource" Uid="BulkTap.Source.Group"/>
            </StackPanel>
            <Grid Name="PnlBtCsv">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Name="TxtBtFile" IsReadOnly="True" Margin="0,4,4,4" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Name="BtnBtBrowse" Uid="Import.Browse"/>
            </Grid>
            <StackPanel Name="PnlBtGroup" Orientation="Horizontal" Visibility="Collapsed">
                <TextBox Name="TxtBtGroupSearch" Uid="Report.GroupSearch" Width="260" Margin="0,4,4,4"/>
                <Button Name="BtnBtFindGroup" Uid="Report.FindGroup" Style="{StaticResource SecondaryButton}"/>
                <ComboBox Name="CmbBtGroup" Width="320" Padding="8,7" Margin="4" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Uid="BulkTap.Lifetime" Style="{StaticResource Label}"/>
                    <TextBox Name="TxtBtLifetime" Text="480" Width="100" Margin="0,4,0,0"/>
                </StackPanel>
                <CheckBox Name="ChkBtUsableOnce" Uid="BulkTap.UsableOnce" Margin="32,18,0,0"/>
            </StackPanel>

            <Border Background="#E0ECF8" CornerRadius="4" Padding="12,10" Margin="0,14,0,12">
                <StackPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Uid="BulkTap.Info1"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Uid="BulkTap.Info2"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="2" Name="DgBt" Margin="20,0,20,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Import.Col.Line" Binding="{Binding Line}" Width="60"/>
                <DataGridTextColumn Header="Import.Col.Status" Binding="{Binding StatusText}" Width="110"/>
                <DataGridTextColumn Header="Import.Col.Upn" Binding="{Binding Upn}" Width="240"/>
                <DataGridTextColumn Header="Import.Col.Name" Binding="{Binding DisplayName}" Width="170"/>
                <DataGridTextColumn Header="BulkTap.Col.Tap" Binding="{Binding Pass}" Width="150" ElementStyle="{StaticResource Mono}"/>
                <DataGridTextColumn Header="BulkTap.Col.ValidUntil" Binding="{Binding ValidText}" Width="140"/>
                <DataGridTextColumn Header="Import.Col.Message" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="20,10,20,16">
            <TextBlock Name="TxtBtStatus" Text="" TextWrapping="Wrap"/>
                <ProgressBar Name="PrgBt" Height="4" Margin="0,6,0,0" Visibility="Hidden"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Name="BtnBtTest" Uid="BulkTap.Test"/>
                <Button Name="BtnBtStart" Uid="BulkTap.Start" Style="{StaticResource StartButton}" IsEnabled="False"/>
                <Button Name="BtnBtExport" Uid="Report.Export" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                <Button Name="BtnBtCancel" Uid="Common.Cancel" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                <Button Name="BtnBtClose" Uid="Common.Close" Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
